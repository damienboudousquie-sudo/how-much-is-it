# Clé OAuth osu! (client credentials, scope public).
# https://osu.ppy.sh/home/account/edit#oauth
# Optionnel. Sans clé, tout fonctionne : lien, ID, recherche par titre et maps à farm
# passent par des miroirs publics. La clé ajoute l'API officielle comme source.
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

PORT=3001
